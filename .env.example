# Copy to .env (never commit .env). Paths are on YOUR machine; the container sees them as /store, /config, ...
# The v1 store (read-only inside the container):
SF_STORE_DIR=D:/AmerAndish/Projects/Trade/StrategyFactory_data/store
# Where v2 keeps its own state (created if missing):
SF_CONFIG_DIR=D:/AmerAndish/Projects/Trade/sf2_docker/config
SF_RUNS_DIR=D:/AmerAndish/Projects/Trade/sf2_docker/runs
SF_LIVE_DIR=D:/AmerAndish/Projects/Trade/sf2_docker/live
# Dashboard sign-in token, at least 16 characters (required: the container listens on its network interface):
SF_WEB_TOKEN=change-me-to-a-long-random-string
# Optional: Telegram bot token for the scheduler's notifications
SF_TELEGRAM_TOKEN=
